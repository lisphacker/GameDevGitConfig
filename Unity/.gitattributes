# =============================================================================
# General
# =============================================================================

* text=auto

# Source
*.cs      text
*.shader  text
*.hlsl    text
*.glsl    text
*.compute text

# Configuration / documentation
*.json    text
*.xml     text
*.yaml    text
*.yml     text
*.md      text
*.txt     text
*.asmdef  text
*.asmref  text

# =============================================================================
# Unity YAML assets
#
# IMPORTANT: Keep these in ordinary Git rather than LFS.
# With Force Text serialization they can be diffed and merged.
# =============================================================================

*.meta                 text
*.unity                text
*.prefab               text
*.asset                text
*.mat                  text
*.anim                 text
*.controller           text
*.overrideController   text
*.physicMaterial       text
*.physicsMaterial2D    text
*.playable             text
*.mask                 text
*.guiskin              text
*.fontsettings         text
*.flare                text
*.renderTexture        text
*.terrainlayer         text
*.mixer                text

# =============================================================================
# 3D assets - Git LFS
# =============================================================================

*.fbx    filter=lfs diff=lfs merge=lfs -text
*.FBX    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.obj    filter=lfs diff=lfs merge=lfs -text
*.3ds    filter=lfs diff=lfs merge=lfs -text
*.dae    filter=lfs diff=lfs merge=lfs -text
*.ma     filter=lfs diff=lfs merge=lfs -text
*.mb     filter=lfs diff=lfs merge=lfs -text
*.max    filter=lfs diff=lfs merge=lfs -text

